{
  "name": "@ppu/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright + axe-core accessibility gate (MVP-023). Development and CI only: nothing here is imported by the application or shipped in its bundle.",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "browsers:install": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@ppu/db": "workspace:*",
    "@ppu/domain-notifications": "workspace:*",
    "@types/node": "^22.20.3",
    "axe-core": "4.13.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
