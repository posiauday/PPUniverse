// Content domain (docs/06-data-model.md "Engagement and content"; MVP-017,
// FR-014). This pass builds `Article` only — tutorials, patterns and
// comparison pages, discriminated by `type` — plus its append-only
// `ArticlePublishEvent` audit trail. `LearningPath`/`LearningPathItem` and
// `SEORecord` remain unbuilt placeholders, deferred as a fast-follow
// (docs/final-decisions.md, "MVP-017 implementation: `Article` only this
// pass..."; docs/open-questions.md item 50). `Collection`/`CollectionItem`
// are out of scope of MVP-017 entirely (docs/final-decisions.md, "MVP-017 /
// `/collections/[slug]` scope conflict...") and nothing here references them.
//
// `body` is stored as Markdown TEXT, never raw HTML — apps/web's render path
// never uses raw-HTML passthrough for it (defense in depth per CLAUDE.md's
// OWASP note: this is user-authored content rendered to every visitor, a
// real stored-XSS surface even though only ADMINs can author it today).
//
// `status`/`publishedAt` mirror catalog.prisma's ProductStatus /
// evidence.prisma's Release.publishedAt pattern exactly: PUBLISHED/non-null
// publishedAt is the only publicly-visible state, and publishedAt is never
// rewritten once set (FR-011's "corrections create another version" spirit —
// a correction here is a new ArticlePublishEvent, not a mutated timestamp;
// full content versioning/snapshotting is out of scope for this first pass,
// see TD candidate recorded in the story's progress report).
//
// authorUserId/actorUserId FKs are Restrict, not Cascade — the same
// audit-trail-adjacent rationale privacy.prisma documents: a cascade would
// let a future user-deletion destroy the record of who authored or
// published content. ArticlePublishEvent is append-only by construction: no
// repository method in packages/adapters/content issues an UPDATE against
// it, exactly like DeletionRequestEvent/EmailSend.
//
// Content-publishing authority reuses the existing ADMIN role — no EDITOR
// role exists or is introduced here (docs/final-decisions.md, "MVP-017
// implementation: content-publishing authorization reuses ADMIN").

enum ArticleType {
  TUTORIAL
  PATTERN
  COMPARISON
  /// MVP-028: feeds a technology section's KPIs tab (docs/final-decisions.md,
  /// "Technology sections (MVP-028)").
  KPI_GUIDE
  /// MVP-038: quick-lookup pages for each hub's Daily reference row
  /// (docs/final-decisions.md, 2026-10-06, "Hub framing").
  REFERENCE
}

/// MVP-028: the six technology sections (docs/final-decisions.md,
/// "Technology sections (MVP-028)"). An article belongs to at most one;
/// none means cross-cutting (it still appears on /learn).
enum Technology {
  POWER_APPS
  POWER_AUTOMATE
  POWER_BI
  COPILOT_STUDIO
  DATAVERSE
  POWER_PAGES
  /// MVP-033: the cross-product Governance & admin area, not a product.
  GOVERNANCE_ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ArticlePublishAction {
  PUBLISHED
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  type         ArticleType
  /// MVP-028: the technology section this article appears in; null = none.
  technology   Technology?
  /// MVP-033: the section of its area's hub (an id from TECHNOLOGY_TOPICS in
  /// @ppu/domain-content); null = the area's first section.
  topic        String?
  /// Markdown source — never rendered as raw HTML (see the file header comment).
  body         String        @db.Text
  /// Used for the page's meta description; null means none was supplied.
  excerpt      String?
  status       ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten — see the file header comment.
  publishedAt  DateTime?
  authorUserId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author  User                  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events  ArticlePublishEvent[]
  votes   ArticleVote[]
  reports ArticleReport[]

  @@index([status])
  @@index([type])
  @@index([technology, status])
  @@map("articles")
}

/// Append-only — this IS the audit trail for Article publishing. One row per
/// publish action: who caused it, what article, when. See the file header
/// comment for why onDelete is Restrict, not Cascade.
model ArticlePublishEvent {
  id          String               @id @default(cuid())
  articleId   String
  actorUserId String
  action      ArticlePublishAction
  createdAt   DateTime             @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@map("article_publish_events")
}

/// MVP-033 slice D (docs/final-decisions.md, "Governance & admin area and the
/// Updates badge"): what kind of platform change an update describes.
enum UpdateKind {
  FEATURE
  LICENSING
  DEPRECATION
  RETIREMENT
}

/// A short note, in our words, on a Power Platform change and whether to act,
/// linked to Microsoft's announcement. Drafted by the agent (content/updates),
/// published by the product owner. Same lifecycle and audit rules as Article.
model UpdateItem {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String
  technology    Technology?
  kind          UpdateKind
  /// A few words on what to do; null for none.
  action        String?
  /// Microsoft's announcement: https on microsoft.com (checked by the API and importer).
  sourceUrl     String
  /// When the change takes effect; drives the deprecation tracker.
  effectiveDate DateTime?     @db.Date
  /// What to switch to, for the tracker.
  replacement   String?
  status        ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten.
  publishedAt   DateTime?
  authorUserId  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author User                 @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events UpdatePublishEvent[]

  @@index([status, publishedAt])
  @@map("update_items")
}

/// Append-only audit trail for publishing an UpdateItem, like ArticlePublishEvent.
model UpdatePublishEvent {
  id          String               @id @default(cuid())
  updateId    String
  actorUserId String
  action      ArticlePublishAction
  createdAt   DateTime             @default(now())

  update UpdateItem @relation(fields: [updateId], references: [id], onDelete: Restrict)
  actor  User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([updateId, createdAt])
  @@map("update_publish_events")
}

/// "Did this fix it?" (MVP-039; docs/final-decisions.md, 2026-10-07, "Votes
/// and reports"). One row per vote, holding nothing about the voter: no user,
/// no IP address, no cookie. Repeat votes are limited by a hashed counter in
/// auth_throttle, deleted after a day.
model ArticleVote {
  id        String   @id @default(cuid())
  articleId String
  helpful   Boolean
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, helpful])
  @@map("article_votes")
}

/// "Something here changed?" (MVP-038): an anonymous note of at most 500
/// characters, with no contact details. It waits in /admin/feedback and is
/// deleted when the admin closes it (the Privacy notice says so).
model ArticleReport {
  id        String   @id @default(cuid())
  articleId String
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("article_reports")
}
