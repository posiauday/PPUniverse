// Content domain (docs/06-data-model.md "Engagement and content"; MVP-017,
// FR-014). This pass builds `Article` only — tutorials, patterns and
// comparison pages, discriminated by `type` — plus its append-only
// `ArticlePublishEvent` audit trail. `LearningPath`/`LearningPathItem` and
// `SEORecord` remain unbuilt placeholders, deferred as a fast-follow
// (docs/final-decisions.md, "MVP-017 implementation: `Article` only this
// pass..."; docs/open-questions.md item 50). `Collection`/`CollectionItem`
// are out of scope of MVP-017 entirely (docs/final-decisions.md, "MVP-017 /
// `/collections/[slug]` scope conflict...") and nothing here references them.
//
// `body` is stored as Markdown TEXT, never raw HTML — apps/web's render path
// never uses raw-HTML passthrough for it (defense in depth per CLAUDE.md's
// OWASP note: this is user-authored content rendered to every visitor, a
// real stored-XSS surface even though only ADMINs can author it today).
//
// `status`/`publishedAt` mirror catalog.prisma's ProductStatus /
// evidence.prisma's Release.publishedAt pattern exactly: PUBLISHED/non-null
// publishedAt is the only publicly-visible state, and publishedAt is never
// rewritten once set (FR-011's "corrections create another version" spirit —
// a correction here is a new ArticlePublishEvent, not a mutated timestamp;
// full content versioning/snapshotting is out of scope for this first pass,
// see TD candidate recorded in the story's progress report).
//
// authorUserId/actorUserId FKs are Restrict, not Cascade — the same
// audit-trail-adjacent rationale privacy.prisma documents: a cascade would
// let a future user-deletion destroy the record of who authored or
// published content. ArticlePublishEvent is append-only by construction: no
// repository method in packages/adapters/content issues an UPDATE against
// it, exactly like DeletionRequestEvent/EmailSend.
//
// Content-publishing authority reuses the existing ADMIN role — no EDITOR
// role exists or is introduced here (docs/final-decisions.md, "MVP-017
// implementation: content-publishing authorization reuses ADMIN").

enum ArticleType {
  TUTORIAL
  PATTERN
  COMPARISON
  /// MVP-028: feeds a technology section's KPIs tab (docs/final-decisions.md,
  /// "Technology sections (MVP-028)").
  KPI_GUIDE
  /// MVP-038: quick-lookup pages for each hub's Daily reference row
  /// (docs/final-decisions.md, 2026-10-06, "Hub framing").
  REFERENCE
}

/// MVP-028: the six technology sections (docs/final-decisions.md,
/// "Technology sections (MVP-028)"). An article belongs to at most one;
/// none means cross-cutting (it still appears on /learn).
enum Technology {
  POWER_APPS
  POWER_AUTOMATE
  POWER_BI
  COPILOT_STUDIO
  DATAVERSE
  POWER_PAGES
  /// MVP-033: the cross-product Governance & admin area, not a product.
  GOVERNANCE_ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ArticlePublishAction {
  PUBLISHED
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  type         ArticleType
  /// MVP-028: the technology section this article appears in; null = none.
  technology   Technology?
  /// MVP-033: the section of its area's hub (an id from TECHNOLOGY_TOPICS in
  /// @ppu/domain-content); null = the area's first section.
  topic        String?
  /// Markdown source — never rendered as raw HTML (see the file header comment).
  body         String        @db.Text
  /// Used for the page's meta description; null means none was supplied.
  excerpt      String?
  status       ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten — see the file header comment.
  publishedAt  DateTime?
  /// MVP-050: a DRAFT's planned publish time; null when none. It stays a
  /// draft until the first visit after this time publishes it (see
  /// apps/web/lib/scheduled-publishing.ts). Cleared on publish.
  scheduledFor DateTime?
  authorUserId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author         User                   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events         ArticlePublishEvent[]
  scheduleEvents ArticleScheduleEvent[]
  votes    ArticleVote[]
  reports  ArticleReport[]
  comments ArticleComment[]

  @@index([status])
  @@index([type])
  @@index([technology, status])
  @@index([status, scheduledFor])
  @@map("articles")
}

/// Append-only — this IS the audit trail for Article publishing. One row per
/// publish action: who caused it, what article, when. See the file header
/// comment for why onDelete is Restrict, not Cascade.
model ArticlePublishEvent {
  id          String               @id @default(cuid())
  articleId   String
  actorUserId String
  action      ArticlePublishAction
  createdAt   DateTime             @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@map("article_publish_events")
}

/// MVP-050: what an admin did to a draft's publish schedule. Setting a new
/// time on a scheduled draft is another SCHEDULED row.
enum ScheduleAction {
  SCHEDULED
  CANCELLED
}

/// Append-only audit trail for scheduling an Article (MVP-050), like
/// ArticlePublishEvent. The publish itself, when the time comes, is an
/// ArticlePublishEvent by the admin who scheduled it.
model ArticleScheduleEvent {
  id           String         @id @default(cuid())
  articleId    String
  actorUserId  String
  action       ScheduleAction
  /// The time set; null for CANCELLED.
  scheduledFor DateTime?
  createdAt    DateTime       @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([createdAt])
  @@map("article_schedule_events")
}

/// MVP-033 slice D (docs/final-decisions.md, "Governance & admin area and the
/// Updates badge"): what kind of platform change an update describes.
enum UpdateKind {
  FEATURE
  LICENSING
  DEPRECATION
  RETIREMENT
}

/// A short note, in our words, on a Power Platform change and whether to act,
/// linked to Microsoft's announcement. Drafted by the agent (content/updates),
/// published by the product owner. Same lifecycle and audit rules as Article.
model UpdateItem {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String
  technology    Technology?
  kind          UpdateKind
  /// A few words on what to do; null for none.
  action        String?
  /// Microsoft's announcement: https on microsoft.com (checked by the API and importer).
  sourceUrl     String
  /// When the change takes effect; drives the deprecation tracker.
  effectiveDate DateTime?     @db.Date
  /// What to switch to, for the tracker.
  replacement   String?
  status        ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten.
  publishedAt   DateTime?
  /// MVP-050: a DRAFT's planned publish time; null when none (as on Article).
  scheduledFor  DateTime?
  authorUserId  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author         User                  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events         UpdatePublishEvent[]
  scheduleEvents UpdateScheduleEvent[]

  @@index([status, publishedAt])
  @@index([status, scheduledFor])
  @@map("update_items")
}

/// Append-only audit trail for publishing an UpdateItem, like ArticlePublishEvent.
model UpdatePublishEvent {
  id          String               @id @default(cuid())
  updateId    String
  actorUserId String
  action      ArticlePublishAction
  createdAt   DateTime             @default(now())

  update UpdateItem @relation(fields: [updateId], references: [id], onDelete: Restrict)
  actor  User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([updateId, createdAt])
  @@map("update_publish_events")
}

/// Append-only audit trail for scheduling an UpdateItem (MVP-050), like ArticleScheduleEvent.
model UpdateScheduleEvent {
  id           String         @id @default(cuid())
  updateId     String
  actorUserId  String
  action       ScheduleAction
  /// The time set; null for CANCELLED.
  scheduledFor DateTime?
  createdAt    DateTime       @default(now())

  update UpdateItem @relation(fields: [updateId], references: [id], onDelete: Restrict)
  actor  User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([updateId, createdAt])
  @@index([createdAt])
  @@map("update_schedule_events")
}

/// "Did this fix it?" (MVP-039; docs/final-decisions.md, 2026-10-07, "Votes
/// and reports"). One row per vote, holding nothing about the voter: no user,
/// no IP address, no cookie. Repeat votes are limited by a hashed counter in
/// auth_throttle, deleted after a day.
model ArticleVote {
  id        String   @id @default(cuid())
  articleId String
  helpful   Boolean
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, helpful])
  @@map("article_votes")
}

/// "Something here changed?" (MVP-038): an anonymous note of at most 500
/// characters, with no contact details. It waits in /admin/feedback and is
/// deleted when the admin closes it (the Privacy notice says so).
model ArticleReport {
  id        String   @id @default(cuid())
  articleId String
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("article_reports")
}

/// A signed-in reader's comment on a guide (MVP-040; docs/final-decisions.md,
/// 2026-10-07, "Top bar names, AI search readiness, and comments"). It shows
/// at once; an admin removes it after reports (removedAt), or marks one as
/// the accepted fix (acceptedAt). Shown under the author's display name only.
model ArticleComment {
  id         String    @id @default(cuid())
  articleId  String
  userId     String
  body       String    @db.VarChar(2000)
  createdAt  DateTime  @default(now())
  removedAt  DateTime?
  acceptedAt DateTime?

  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  reports CommentReport[]

  @@index([articleId, createdAt])
  @@index([userId, createdAt])
  @@map("article_comments")
}

/// Someone reported a comment (MVP-040). Nothing about the reporter is kept;
/// a hashed per-address counter limits reports. Deleted with the comment.
model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  createdAt DateTime @default(now())

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_reports")
}

/// The Learn module (MVP-048; docs/final-decisions.md, 2026-10-07, "Learn
/// module design: Workspace"; docs/plans/learn-module.md): a topic is a short
/// series of 3 to 6 lessons at /topics/<topic>/<lesson>. Drafted in
/// content/topics and imported as drafts, or written in the admin; published
/// by the product owner. Same lifecycle and audit rules as Article: publishedAt
/// is set once and never rewritten, and every publish appends a
/// LearnPublishEvent. A lesson is public only when it and its topic are both
/// PUBLISHED. Lesson bodies are Markdown, never rendered as raw HTML.
model LearnTopic {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  /// One or two sentences: what the topic explains and for whom.
  summary      String
  /// The area it belongs to: one of the six technologies or Governance & admin.
  technology   Technology
  /// Order among the area's topics, lowest first.
  sortOrder    Int           @default(0)
  status       ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten.
  publishedAt  DateTime?
  authorUserId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author  User                @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  lessons LearnLesson[]
  events  LearnPublishEvent[]

  @@index([technology, status, sortOrder])
  @@map("learn_topics")
}

model LearnLesson {
  id           String        @id @default(cuid())
  topicId      String
  /// Unique within its topic.
  slug         String
  /// 1-based place in the topic, unique within it.
  position     Int
  title        String
  /// Reading time in minutes.
  minutes      Int
  /// "What you'll understand": 2 or 3 short outcomes.
  outcomes     String[]
  /// Markdown in the fixed lesson shape (@ppu/domain-content LESSON_SECTIONS).
  body         String        @db.Text
  /// When it was last checked against its sources; null if never.
  checkedOn    DateTime?     @db.Date
  status       ArticleStatus @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten.
  publishedAt  DateTime?
  authorUserId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  topic    LearnTopic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  author   User                @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events   LearnPublishEvent[]
  progress LessonProgress[]

  @@unique([topicId, slug])
  @@unique([topicId, position])
  @@map("learn_lessons")
}

/// Append-only audit trail for publishing topics and lessons: lessonId is
/// null when the topic itself was published.
model LearnPublishEvent {
  id          String               @id @default(cuid())
  topicId     String
  lessonId    String?
  actorUserId String
  action      ArticlePublishAction
  createdAt   DateTime             @default(now())

  topic  LearnTopic   @relation(fields: [topicId], references: [id], onDelete: Restrict)
  lesson LearnLesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  actor  User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([topicId, createdAt])
  @@map("learn_publish_events")
}

/// A signed-in reader marked a lesson as done (MVP-048; docs/final-decisions.md,
/// 2026-10-08, "Learn: lessons need sign-in; progress saved to the account").
/// Personal data: only the reader sees it, they can clear it, and it goes
/// with their account (Cascade), as the Privacy notice says.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson LearnLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// The Power Apps component library (MVP-049; docs/final-decisions.md,
/// 2026-10-08, "Power Apps component library: first, copy-paste YAML, free").
/// Imported from content/components as drafts. Publishing needs a recorded
/// paste-test (testedAt, testedStudioVersion) of the current YAML; replacing
/// a draft's YAML clears it. `hidden` lets the product owner take a published
/// component off the site without losing its history. `yaml` and `guide` are
/// text, never rendered as raw HTML.
enum ComponentAccess {
  /// Anyone can copy the YAML.
  OPEN
  /// Free, but copying the YAML needs sign-in.
  MEMBERS
}

enum ComponentEventAction {
  TESTED
  PUBLISHED
  SETTINGS_CHANGED
}

model LibraryComponent {
  id                  String          @id @default(cuid())
  slug                String          @unique
  title               String
  /// The component's name in Power Apps, such as lcsButton.
  componentName       String
  /// An id from COMPONENT_CATEGORIES in @ppu/domain-content.
  category            String
  summary             String
  /// The guide, as Markdown.
  guide               String          @db.Text
  /// The paste-ready pa.yaml (schema v3.0) text.
  yaml                String          @db.Text
  /// The custom properties read from the YAML (ComponentProperty[]).
  properties          Json
  /// Named presets (ComponentVariation[]).
  variations          Json
  access              ComponentAccess @default(OPEN)
  version             String
  needsModernControls Boolean         @default(true)
  status              ArticleStatus   @default(DRAFT)
  /// Null means draft. Set once, on publish, and never rewritten.
  publishedAt         DateTime?
  hidden              Boolean         @default(false)
  /// A draft shown as "Coming soon": its card and page, with a blurred
  /// picture and nothing to copy (2026-10-09). Ignored once published.
  comingSoon          Boolean         @default(false)
  testedAt            DateTime?
  testedStudioVersion String?
  authorUserId        String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  author User             @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  events ComponentEvent[]

  @@index([status, hidden, category])
  @@map("library_components")
}

/// Append-only audit trail for the component library: tests, publishes and
/// setting changes (detail holds what changed).
model ComponentEvent {
  id          String               @id @default(cuid())
  componentId String
  actorUserId String
  action      ComponentEventAction
  detail      Json?
  createdAt   DateTime             @default(now())

  component LibraryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  actor     User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([componentId, createdAt])
  @@index([createdAt])
  @@map("component_events")
}
