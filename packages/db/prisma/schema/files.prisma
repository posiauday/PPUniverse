// Versioning and files domain (docs/06-data-model.md). FileScan (MVP-006)
// and ReleaseFile (MVP-012, joining Release and an already-CLEAN FileScan)
// are modeled here. ChangelogEntry/Download/SignedDownloadGrant belong to
// the stories that still need them (MVP-014 and later).

enum FileScanStatus {
  UPLOADED
  QUARANTINED
  SCANNING
  CLEAN
  REJECTED
  OVERRIDDEN
}

model FileScan {
  id               String         @id @default(cuid())
  storageKey       String         @unique
  originalFilename String
  declaredMimeType String
  detectedMimeType String?
  sizeBytes        Int
  status           FileScanStatus @default(UPLOADED)
  rejectionReason  String?
  uploadedByUserId String
  uploadedBy       User           @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  scanStartedAt    DateTime?
  scanCompletedAt  DateTime?

  releaseFiles ReleaseFile[]

  @@index([uploadedByUserId])
  @@map("file_scans")
}

/// Joins a Release to an already-CLEAN FileScan (MVP-012, FR-009). Written
/// only by PrismaCatalogRepository.attachReleaseFile, which re-verifies
/// FileScan.status === "CLEAN" server-side before creating this row — never
/// trusts a client-supplied "this file is clean" claim. onDelete: Restrict
/// on fileScan mirrors Category on Product: a scanned file already attached
/// to a release must not be deletable out from under it.
model ReleaseFile {
  releaseId  String
  fileScanId String
  createdAt  DateTime @default(now())

  release  Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  fileScan FileScan @relation(fields: [fileScanId], references: [id], onDelete: Restrict)

  @@id([releaseId, fileScanId])
  @@index([fileScanId])
  @@map("release_files")
}
