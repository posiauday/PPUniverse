// Catalog domain (docs/06-data-model.md). Only Category and Product are
// modeled for MVP-003, scoped to exactly what "indexable category and
// product listing pages render" (FR-001) needs — a single primary
// category per product, not the full ProductCategory many-to-many join
// table the data model sketches (reversible to add later if a product
// ever needs multiple categories). The MVP-005 evidence entities (license,
// release, support, compatibility) live in evidence.prisma; Prerequisite,
// ProductMedia and ProductDocument remain unbuilt; Collection/
// CollectionItem have no owning story yet (docs/open-questions.md).
// ProductStatusEvent (MVP-019, FR-015/NFR-009) is the append-only audit
// trail for SUSPENDED/ARCHIVED transitions — see docs/final-decisions.md,
// "MVP-019 operations console and audit: open questions evaluated and
// decided".

enum AssetType {
  POWER_APPS_COMPONENT
  POWER_APPS_TEMPLATE
  POWER_AUTOMATE_TEMPLATE
  POWER_BI_TEMPLATE
  ARCHITECTURE_BLUEPRINT
  GOVERNANCE_ASSET
}

/// SUSPENDED and ARCHIVED added MVP-019. Valid transitions (enforced in
/// packages/domain/catalog, not just here): PUBLISHED <-> SUSPENDED,
/// PUBLISHED -> ARCHIVED, SUSPENDED -> ARCHIVED. ARCHIVED is terminal --
/// no transition out of it exists. DRAFT cannot go directly to either
/// (nothing public to suspend/retire yet); DRAFT -> PUBLISHED remains
/// MVP-012's own publish flow, untouched by MVP-019.
enum ProductStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  assetType   AssetType @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  summary     String
  status      ProductStatus @default(DRAFT)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  licenses      ProductLicense[]
  releases      Release[]
  supportPolicy SupportPolicy?
  compatibility CompatibilityRecord[]
  entitlements  Entitlement[]
  statusEvents  ProductStatusEvent[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/// Append-only audit trail for every SUSPENDED/ARCHIVED transition
/// (MVP-019). Structurally identical to ArticlePublishEvent/
/// ReleasePublishEvent: Restrict FKs, no UPDATE path. `reason` is nullable
/// at the schema level but required by application logic for every
/// transition this story writes (docs/final-decisions.md, "MVP-019
/// operations console and audit" -- question 5) -- the same
/// per-action-value strictness pattern DeletionRequestEvent.reason
/// established (required for DENIED, optional otherwise; here, required
/// for all four transitions this table records).
model ProductStatusEvent {
  id          String        @id @default(cuid())
  productId   String
  actorUserId String
  fromStatus  ProductStatus
  toStatus    ProductStatus
  reason      String?
  createdAt   DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@map("product_status_events")
}
