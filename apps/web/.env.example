DATABASE_URL="postgresql://user:password@localhost:5432/ppuniverse?schema=public"
NEXTAUTH_SECRET="generate-a-real-random-32-byte-secret-for-each-environment"
NEXTAUTH_URL="http://localhost:3000"
EMAIL_FROM="no-reply@example.com"

# File storage (MVP-006) — MinIO locally/CI via docker-compose.yml; real vendor still open (docs/open-questions.md item 5)
S3_BUCKET="ppuniverse"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Malware scanning (MVP-006) — ClamAV locally/CI via docker-compose.yml; real vendor still open (docs/open-questions.md item 9)
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# Error monitoring (MVP-022) — Sentry (docs/final-decisions.md). Optional:
# unset falls back to logging locally instead of failing to start (no DSN
# has been provisioned yet, docs/open-questions.md item 18).
SENTRY_DSN=""

# Public site origin (MVP-021, FR-017): canonical URLs, Open Graph tags, sitemap.xml and structured data.
# Dedicated to SEO — NOT NEXTAUTH_URL, which is authentication-specific. It is a public origin, not a secret.
# A bare origin only (no path, query or credentials); trailing slashes are normalized.
# Production requires an absolute https URL on a public hostname. http://localhost is accepted only in development and test,
# where an unset value falls back to http://localhost:3000. It is never guessed or hardcoded (product name and domain are still
# open, docs/open-questions.md item 1): if it is missing or invalid in production the site keeps serving but omits canonical
# URLs and structured data, returns an empty sitemap, and logs seo.site_url_invalid.
# Server code reads it at runtime (verified against a production build), so it can be set per environment at start-up.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
