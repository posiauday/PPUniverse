{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace Product Metadata",
  "type": "object",
  "required": [
    "title",
    "slug",
    "summary",
    "platforms",
    "assetType",
    "license",
    "support",
    "compatibility",
    "version"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "assetType": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "support": {
      "enum": [
        "creator",
        "platform",
        "community",
        "none"
      ]
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "version": {
      "type": "string"
    },
    "accessibility": {
      "type": "object"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
